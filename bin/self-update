#!/usr/bin/env bash

set -euo pipefail

root="${HOME}/.dotfiles"
# `uname -n` follows the network: with HostName unset, macOS takes the name a reverse
# DNS lookup gives its address (a phone hotspot answers "mac"), so the LocalHostName
# set in System Settings picks the host Brewfile; scutil is absent off macOS
host=$(scutil --get LocalHostName 2>/dev/null || uname -n)
host=${host%.local}
keep_going=false
verbose_flag= # becomes --verbose with -v, for the steps that can explain themselves
failures=()
outcome=failed # becomes success or partial only on the way out

# any exit not marked as success or partial is a hard error (1), whatever its status,
# so 2 always means a partial success; bash 3.2 may even report 0 after a set -u abort
function normalize_exit() {
  case "${outcome}" in
  success) exit 0 ;;
  partial) exit 2 ;;
  *) exit 1 ;;
  esac
}
trap normalize_exit EXIT

# tolerate runs a step that may fail for reasons outside the dotfiles,
# e.g. an upstream cask pointing at a pulled download; with --keep-going
# the failure is recorded and reported at the end instead of aborting the run
function tolerate() {
  if "${keep_going}"; then
    "$@" || failures+=("$*")
  else
    "$@"
  fi
}

function ensure_clean() {
  local hint=$1 dirty
  dirty=$(git -C "${root}" status --porcelain)
  if [ -n "${dirty}" ]; then
    echo "self-update: uncommitted changes in ${root}:" >&2
    echo "${dirty}" >&2
    echo "${hint}" >&2
    exit 1
  fi
}

function update_apps() {
  tolerate "${root}"/toolset/Apps install
  tolerate mas upgrade
}

function update_brew() {
  if ! command -v brew >/dev/null; then
    return
  fi
  local common="${root}/toolset/Brewfile"
  local own="${root}/toolset/${host}.Brewfile"

  brew update --force --quiet
  # brew bundle stays verbose: without it the install output is captured, so a long
  # download or a prompt looks like a hang; -v makes only the other steps verbose

  # an empty host file would clean up everything, so it counts as missing
  if [ -s "${own}" ]; then
    tolerate brew bundle --file="${own}" --verbose --upgrade --force --force-cleanup
  else
    # without the host's own list the common one is only a minimum: cleaning up to it
    # would uninstall everything else, so it only installs and upgrades
    echo "self-update: no Brewfile for host '${host}' in ${root}/toolset; installing the common one without cleanup" >&2
    # the environment can request cleanup too, so it is cleared for this call
    tolerate env -u HOMEBREW_BUNDLE_INSTALL_CLEANUP -u HOMEBREW_BUNDLE_FORCE_INSTALL_CLEANUP \
      brew bundle --file="${common}" --verbose --upgrade --force
  fi
  brew upgrade --formula --yes
  tolerate brew cu --all --cleanup --no-brew-update --yes ${verbose_flag:+"${verbose_flag}"}
  "${root}"/bin/unquarantine || echo "unquarantine: some apps are still quarantined" >&2
  # warnings are printed either way; --verbose adds the environment dump for bug reports
  brew doctor ${verbose_flag:+"${verbose_flag}"} || true
}

# `daemon version` asks the running daemon over this socket and fails without one,
# whether the daemon is stopped, not started since boot or never installed;
# the socket is a symlink into /tmp, so a reboot leaves it dangling and -S false
function codex_daemon_running() {
  [ -S "${CODEX_HOME:-${HOME}/.codex}/app-server-control/app-server-control.sock" ]
}

function sync_codex_daemon() {
  local versions action
  # nothing to sync: Codex installs the daemon package from the CLI on its next start
  if ! codex_daemon_running; then
    echo "Codex daemon is not running; skipping"
    return
  fi
  versions=$(codex app-server daemon version) || return
  action=$(jq -er '
    def version: type == "string" and length > 0;
    if (.cliVersion | version) and
       has("managedCodexVersion") and has("appServerVersion") and
       (.managedCodexVersion | . == null or version) and
       (.appServerVersion | . == null or version)
    then
      if .managedCodexVersion == null and .appServerVersion == null then "absent"
      elif .managedCodexVersion == .cliVersion and
           (.appServerVersion == null or .appServerVersion == .cliVersion)
      then "current"
      else "update"
      end
    else error("invalid Codex daemon version response")
    end
  ' <<<"${versions}") || return

  case "${action}" in
  absent)
    echo "Codex daemon is not installed; skipping"
    ;;
  current)
    echo "Codex daemon matches the installed CLI; up to date"
    ;;
  update)
    echo "Syncing Codex daemon with the installed CLI; active sessions may be interrupted"
    codex app-server daemon update --from-cli --yes
    ;;
  esac
}

function update_codex() {
  if command -v codex >/dev/null; then
    tolerate sync_codex_daemon
  fi
}

# `plannotator update` installs a release through the upstream install.sh, whose
# `curl -fsSL` fetches a binary of ~170 MB without a word: on a slow route to GitHub
# the step looks hung for half an hour. self-update runs that script the way the native
# updater does, with a progress bar on this one line, and leaves the update to the
# native updater whenever the script or the setup is not what this relies on
# shellcheck disable=SC2016 # lines of install.sh, expanded there
plannotator_silent='curl -fsSL -o "$tmp_file" --speed-limit 1 --speed-time 60 "$binary_url"'
# shellcheck disable=SC2016
plannotator_loud='curl -fSL --progress-bar -o "$tmp_file" --speed-limit 1 --speed-time 60 "$binary_url"'
plannotator_fallback=75 # install_plannotator could not start; nothing was installed

function update_plannotator() {
  if command -v plannotator >/dev/null; then
    tolerate plannotator_update
  fi
}

function plannotator_update() {
  local check latest status=0
  check=$(plannotator update --check) || return
  latest=$(sed -n 's/^Plannotator \([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\) is available (you have .*)\.$/\1/p' <<<"${check}")
  if [ -z "${latest}" ]; then
    if [[ "${check}" == *'Up to date'* ]]; then
      echo "${check}"
      return
    fi
    echo "self-update: plannotator: unknown answer of 'plannotator update --check'; using the native updater" >&2
    plannotator update
    return
  fi
  echo "${check%%$'\n'*}"
  install_plannotator "${latest}" || status=$?
  case "${status}" in
  "${plannotator_fallback}") plannotator update ;;
  # Ctrl-C stops the whole run, as it would anywhere else, not only this step
  130)
    echo "self-update: plannotator: interrupted" >&2
    exit 130
    ;;
  *) return "${status}" ;;
  esac
}

function plannotator_cannot() {
  echo "self-update: plannotator: $*; using the native updater" >&2
  return "${plannotator_fallback}"
}

# runs install.sh the way the native updater does: staged by `plannotator update-prepare`
# (the script and the pinned checksums, fetched through Plannotator's own TLS roots),
# with the same arguments and environment, under the same lock; returns plannotator_fallback
# while nothing has been installed yet, and install.sh's status once it has started
function install_plannotator() {
  local version=$1 data flags=0
  # only the copy install.sh manages can be replaced by it
  if ! [ "$(command -v plannotator)" -ef "${HOME}/.local/bin/plannotator" ]; then
    plannotator_cannot "$(command -v plannotator) is not the copy install.sh manages"
    return
  fi
  data=$(plannotator data-dir) && [ -d "${data}" ] || {
    plannotator_cannot "no data folder"
    return
  }
  # without the file the native updater installs with the defaults, and so does this;
  # flags would have to be translated into options of install.sh
  if [ -f "${data}/install-flags.json" ]; then
    flags=$(jq -r 'if .v == 1 then .flags | length else "unknown" end' "${data}/install-flags.json" 2>/dev/null) ||
      flags=unknown
  fi
  if [ "${flags}" != 0 ]; then
    plannotator_cannot "the last install had options in ${data}/install-flags.json"
    return
  fi
  (
    lock="${data}/update.lock" holder='' dir='' status=0
    # nothing to clean up until it is set: the lock only while it is still this run's
    trap '[ -z "${dir}" ] || rm -rf "${dir}"
      [ -z "${holder}" ] || [ "$(cat "${lock}" 2>/dev/null)" != "${holder}" ] || rm -f "${lock}"' EXIT
    trap 'exit 130' INT TERM HUP
    # the form Plannotator can judge: a holder that is gone frees the lock at once, not in an hour
    candidate="pid=$$ group=$(ps -o pgid= -p $$ | tr -d ' ') host=$(uname -n) boot= pidns="
    # an update in progress, or a lock it left behind, is the native updater's to judge
    if ! (set -o noclobber && echo "${candidate}" >"${lock}") 2>/dev/null; then
      plannotator_cannot "${lock} is taken"
      exit
    fi
    holder=${candidate}
    staged=$(plannotator update-prepare "v${version}" </dev/null) || staged=''
    case "${staged}" in
    *$'\n'* | */) ;;
    /*/plannotator-update-?*) dir=${staged} ;;
    esac
    if [ -z "${dir}" ] || [ ! -f "${dir}/install.sh" ]; then
      plannotator_cannot "plannotator update-prepare did not stage the update"
      exit
    fi
    script="${dir}/install.sh"
    # the assert: the upstream script still has exactly the one silent download to adapt
    if ! grep -qF 'REPO="backnotprop/plannotator"' "${script}" ||
      [ "$(grep -cxF -- "${plannotator_silent}" "${script}")" -ne 1 ]; then
      plannotator_cannot "install.sh changed upstream, the download line was not found; adapt self-update"
      exit
    fi
    awk -v silent="${plannotator_silent}" -v loud="${plannotator_loud}" \
      '$0 == silent { print loud; next } { print }' "${script}" >"${script}.loud" &&
      [ "$(grep -cxF -- "${plannotator_loud}" "${script}.loud")" -eq 1 ] || {
      plannotator_cannot "install.sh could not be adapted"
      exit
    }
    if [ -f "${dir}/curl-ca-bundle.pem" ]; then
      export CURL_CA_BUNDLE="${dir}/curl-ca-bundle.pem"
    fi
    echo "Installing v${version}; the download shows its progress"
    # PLANNOTATOR_UPDATE_VERSION tells install.sh this is an update, not a pin, so it updates
    # the Claude Code plugin too; the git limits keep that fetch from hanging on a slow route
    PLANNOTATOR_UPDATE_VERSION="v${version}" \
      PLANNOTATOR_EXPECTED_SHA256="$(cat "${dir}/expected-sha256" 2>/dev/null)" \
      PLANNOTATOR_UPDATE_MISMATCH_FILE="${dir}/checksum-mismatch" \
      GIT_HTTP_LOW_SPEED_LIMIT="${GIT_HTTP_LOW_SPEED_LIMIT:-1}" \
      GIT_HTTP_LOW_SPEED_TIME="${GIT_HTTP_LOW_SPEED_TIME:-60}" \
      bash "${script}.loud" --version "v${version}" --non-interactive </dev/null || status=$?
    if [ -f "${dir}/checksum-mismatch" ]; then
      echo "self-update: plannotator: the download did not match the pinned checksum; nothing was changed" >&2
      status=1
    fi
    # the status of a started install is install.sh's, never a reason to start over
    [ "${status}" -ne "${plannotator_fallback}" ] || status=1
    exit "${status}"
  )
}

function update_docker() {
  if command -v docker >/dev/null; then
    # the CLI comes from Homebrew, the daemon from Docker Desktop, which may simply be closed
    if ! docker info >/dev/null 2>&1; then
      echo "Docker daemon is not running; images were not updated"
      return
    fi
    docker images --filter dangling=false --format '{{.Repository}}:{{.Tag}}' |
      grep -v '<none>' |
      sort -u |
      xargs -r -n1 docker pull || true
    echo Docker images were updated
  fi
}

function update_dotfiles() {
  (
    cd "${root}" || exit 1
    git pull --all --prune --tags --force --rebase && git submodule update --init --recursive
    echo dotfiles were updated
    git_config >/dev/null
    echo git config was applied
  )
}

function clean_tools() {
  if command -v go >/dev/null; then
    local bin
    bin=$(go env GOBIN)
    bin=${bin:-$(go env GOPATH)/bin}
    if [ "${HOME}"/go/bin != "${bin}" ]; then
      echo please take a look, go is not in the right place
      return 1
    fi
    rm -rf "${HOME}"/go/bin/*
  fi
}

function update_tools() {
  if command -v go >/dev/null; then
    clean_tools
    local before=${#failures[@]}
    tolerate make -C "${root}" ${verbose_flag:+verbose} install
    if [ ${#failures[@]} -eq "${before}" ]; then echo tools were installed; fi
  fi
}

function update_zsh() {
  if [ -n "${ZSH-}" ] && [ -f "${ZSH}"/tools/upgrade.sh ]; then
    env ZSH="${ZSH}" zsh -f "${ZSH}"/tools/upgrade.sh
    echo Oh My Zsh was updated
  fi
}

# the run ends with `git reset --hard`, so nothing local may be at risk
ensure_clean "commit or stash them first"

UPDATE=()

while [ $# -gt 0 ]; do
  case "${1}" in
  -k | --keep-going)
    keep_going=true
    shift
    ;;
  -v | --verbose)
    verbose_flag=--verbose
    shift
    ;;
  *)
    break
    ;;
  esac
done

if [ $# -eq 0 ]; then
  UPDATE+=(update_dotfiles)
elif [ "${1:-}" = "all" ]; then
  # Sync the daemon after Homebrew updates the CLI, last because it may restart sessions.
  UPDATE=(update_apps update_dotfiles update_brew update_docker update_tools update_zsh update_plannotator update_codex)
else
  for type in "$@"; do
    case "${type}" in
    apps)
      UPDATE+=(update_apps)
      ;;
    brew)
      UPDATE+=(update_brew)
      ;;
    codex)
      UPDATE+=(update_codex)
      ;;
    docker)
      UPDATE+=(update_docker)
      ;;
    dots)
      UPDATE+=(update_dotfiles)
      ;;
    plannotator)
      UPDATE+=(update_plannotator)
      ;;
    tools)
      UPDATE+=(update_tools)
      ;;
    zsh)
      UPDATE+=(update_zsh)
      ;;
    *)
      UPDATE+=("echo unknown type: ${type}")
      ;;
    esac
  done
fi

for update in "${UPDATE[@]}"; do
  eval "${update}"
done

if [ ${#failures[@]} -gt 0 ]; then
  echo "self-update: finished with failures:" >&2
  printf '  %s\n' "${failures[@]}" >&2
fi

# the tree may change while the run goes (another session, an editor, a step of the run);
# such changes are not the run's to discard, so the run fails the way it would at the start
ensure_clean "they appeared during the run, so nothing was reset; commit or stash them and run again"
(cd "${root}" && git reset --hard) # clean up

case $(basename "${SHELL}") in
bash)
  echo source "${HOME}"/.bash_profile
  ;;
zsh)
  echo source "${HOME}"/.zshrc
  ;;
*)
  echo unknown shell "${SHELL}"
  exit 1
  ;;
esac

if [ ${#failures[@]} -gt 0 ]; then
  outcome=partial
  exit 2
fi
outcome=success
